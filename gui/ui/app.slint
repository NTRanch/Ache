// ache-gui UI: Lana's room — a stage, a toy shelf, and a guidebook.
//
// Owner ruling 2026-11-27 06:13 PT: the wow layer still "basically
// looks like vscode" — drop the IDE skeleton. There are no tabs, no
// sidebar, no document panes. The window is her room: Lana floats
// center-stage (grab her and pick her up — src/drag.rs owns the
// transform), the catalogue is a shelf drawer that slides over the
// stage, a device's detail is a card floating beside her, the trial
// is the stage itself (her body is the display; the rig is a stack
// of floating cards), and the lexicon is a book that opens over the
// room. The wow layer's plain-words copy carries over verbatim
// wherever the words still point at something real.
//
// Safety shape, by construction: the master switch exists only as a
// rendered OFF pill. There is no property, callback, or code path
// in this file that can enable a control or reach a real device. The
// Lana trial is a simulation over virtual devices (see src/trial.rs);
// it constructs no provider and cannot reach ache's decide() gate.
// STOP on the stage is the trial's clear — virtual toys only — and
// it is on screen, reachable in one action, at all times.
//
// Theme (Owner ruling, 2026-11-27 01:07 PT): dark mode by default,
// plum ground, purple/pink accent pair, forced in code via
// Palette.color-scheme at init. All app-owned colours come from the
// Theme global; body text pairs measure WCAG AA on this ground.

import {
    AboutSlint,
    Button,
    LineEdit,
    ListView,
    Palette,
    ScrollView,
    Slider,
    Switch,
} from "std-widgets.slint";

export global Theme {
    out property <color> background: #1e1930;
    out property <color> foreground: #f5f2fa;
    out property <color> muted: #b9aec9;
    out property <color> faint: #9a8bb0;
    out property <color> border: #453761;
    out property <color> surface: #2a2140;
    out property <color> accent: #8b5cf6;
    out property <color> accent-bright: #c4b5fd;
    out property <color> accent-deep: #4c1d95;
    out property <color> pink: #ec4899;
    out property <color> pink-bright: #f9a8d4;
    out property <color> link: #f472b6;
    out property <color> chip-a: #7c3aed;
    out property <color> chip-a-g: #a21caf;
    out property <color> chip-b: #be185d;
    out property <color> chip-c: #9f1239;
    out property <color> state-en: #4ade80;
    out property <color> state-dead: #f87171;
    out property <color> warn: #fbbf24;
}

/// Estate-produced imagery: per-family form-factor stills and
/// 12-frame turntable strips (Blender renders of estate-authored
/// generic meshes — NOT product likenesses), plus Lana's full-body
/// figure art (candidate-class; admission is the Owner's eye).
export global Assets {
    out property <image> egg: @image-url("../assets/families/egg.png");
    out property <image> insertable: @image-url("../assets/families/insertable.png");
    out property <image> rabbit: @image-url("../assets/families/rabbit.png");
    out property <image> plug: @image-url("../assets/families/plug.png");
    out property <image> panty: @image-url("../assets/families/panty.png");
    out property <image> suction: @image-url("../assets/families/suction.png");
    out property <image> butterfly: @image-url("../assets/families/butterfly.png");
    out property <image> kegel: @image-url("../assets/families/kegel.png");
    out property <image> bullet: @image-url("../assets/families/bullet.png");
    out property <image> wand: @image-url("../assets/families/wand.png");
    out property <image> clip: @image-url("../assets/families/clip.png");
    out property <image> external: @image-url("../assets/families/external.png");
    out property <image> rideon: @image-url("../assets/families/rideon.png");
    out property <image> nipple: @image-url("../assets/families/nipple.png");
    out property <image> beads: @image-url("../assets/families/beads.png");
    out property <image> controller: @image-url("../assets/families/controller.png");
    out property <image> other: @image-url("../assets/families/other.png");
    out property <image> egg-spin: @image-url("../assets/spin/egg.png");
    out property <image> insertable-spin: @image-url("../assets/spin/insertable.png");
    out property <image> rabbit-spin: @image-url("../assets/spin/rabbit.png");
    out property <image> plug-spin: @image-url("../assets/spin/plug.png");
    out property <image> panty-spin: @image-url("../assets/spin/panty.png");
    out property <image> suction-spin: @image-url("../assets/spin/suction.png");
    out property <image> butterfly-spin: @image-url("../assets/spin/butterfly.png");
    out property <image> kegel-spin: @image-url("../assets/spin/kegel.png");
    out property <image> bullet-spin: @image-url("../assets/spin/bullet.png");
    out property <image> wand-spin: @image-url("../assets/spin/wand.png");
    out property <image> clip-spin: @image-url("../assets/spin/clip.png");
    out property <image> external-spin: @image-url("../assets/spin/external.png");
    out property <image> rideon-spin: @image-url("../assets/spin/rideon.png");
    out property <image> nipple-spin: @image-url("../assets/spin/nipple.png");
    out property <image> beads-spin: @image-url("../assets/spin/beads.png");
    out property <image> controller-spin: @image-url("../assets/spin/controller.png");
    out property <image> other-spin: @image-url("../assets/spin/other.png");
    out property <image> lana-portrait: @image-url("../assets/lana/lana.png");
    out property <image> lana-idle: @image-url("../assets/lana/idle.png");
    out property <image> lana-guiding: @image-url("../assets/lana/guiding.png");
    out property <image> lana-waiting: @image-url("../assets/lana/waiting.png");
    out property <image> lana-success: @image-url("../assets/lana/success.png");
    out property <image> lana-error: @image-url("../assets/lana/error.png");
}

export struct DeviceRow {
    brand: string,
    device: string,
    device-type: string,
    bucket: string,
    untested: bool,
    link-state: string,
    url: string,
    has-url: bool,
    family: string,
    index: int,
}

export struct ChannelRow {
    label: string,
    level: int,
    max: int,
}

export struct TrialToyRow {
    toy-index: int,
    name: string,
    family: string,
    pleasure: int,
    force: int,
    channel-count: int,
    y-offset: int,
    card-height: int,
    channels: [ChannelRow],
    spark: image,
}

export struct LexiconRow {
    title: string,
    meta: string,
}

/// The still for a family (turntable frame 0).
component FamilyStill inherits Image {
    in property <string> family;
    source: root.family == "egg" ? Assets.egg
        : root.family == "insertable" ? Assets.insertable
        : root.family == "rabbit" ? Assets.rabbit
        : root.family == "plug" ? Assets.plug
        : root.family == "panty" ? Assets.panty
        : root.family == "suction" ? Assets.suction
        : root.family == "butterfly" ? Assets.butterfly
        : root.family == "kegel" ? Assets.kegel
        : root.family == "bullet" ? Assets.bullet
        : root.family == "wand" ? Assets.wand
        : root.family == "clip" ? Assets.clip
        : root.family == "external" ? Assets.external
        : root.family == "rideon" ? Assets.rideon
        : root.family == "nipple" ? Assets.nipple
        : root.family == "beads" ? Assets.beads
        : root.family == "controller" ? Assets.controller
        : Assets.other;
    image-fit: contain;
}

/// The turntable strip for a family, clipped to one 192px frame.
component FamilySpin inherits Image {
    in property <string> family;
    in property <int> frame;
    source: root.family == "egg" ? Assets.egg-spin
        : root.family == "insertable" ? Assets.insertable-spin
        : root.family == "rabbit" ? Assets.rabbit-spin
        : root.family == "plug" ? Assets.plug-spin
        : root.family == "panty" ? Assets.panty-spin
        : root.family == "suction" ? Assets.suction-spin
        : root.family == "butterfly" ? Assets.butterfly-spin
        : root.family == "kegel" ? Assets.kegel-spin
        : root.family == "bullet" ? Assets.bullet-spin
        : root.family == "wand" ? Assets.wand-spin
        : root.family == "clip" ? Assets.clip-spin
        : root.family == "external" ? Assets.external-spin
        : root.family == "rideon" ? Assets.rideon-spin
        : root.family == "nipple" ? Assets.nipple-spin
        : root.family == "beads" ? Assets.beads-spin
        : root.family == "controller" ? Assets.controller-spin
        : Assets.other-spin;
    source-clip-x: root.frame * 192;
    source-clip-y: 0;
    source-clip-width: 192;
    source-clip-height: 192;
    image-fit: contain;
}

/// A floating card: the room's only container shape. Translucent
/// plum, one rounded outline — never a panel in a grid.
component FloatCard inherits Rectangle {
    background: #2a2140f5;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border;
}

/// A pill-shaped navigation / action chip.
component NavChip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    width: chip-label.preferred-width + 26px;
    height: 30px;
    border-radius: 15px;
    border-width: 1px;
    border-color: Theme.border;
    background: root.active ? Theme.accent-deep : Theme.surface;

    chip-label := Text {
        x: 13px;
        height: 100%;
        text: root.text;
        color: root.active ? white : Theme.foreground;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// One device on the toy shelf: a card, not a table row.
component ShelfCard inherits Rectangle {
    in property <DeviceRow> data;
    callback open-url(string);
    callback device-selected(int);

    height: 74px;

    Rectangle {
        x: 5px;
        y: 4px;
        width: parent.width - 10px;
        height: 66px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        background: #352a52;

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.device-selected(data.index);
            }
        }

        HorizontalLayout {
            padding: 7px;
            spacing: 10px;

            FamilyStill {
                width: 46px;
                height: 46px;
                family: data.family;
            }

            Rectangle {
                width: 40px;
                height: 22px;
                y: 4px;
                border-radius: 4px;
                background: data.bucket == "A" ? Theme.chip-a
                    : data.bucket == "A-g" ? Theme.chip-a-g
                    : data.bucket == "B" ? Theme.chip-b
                    : Theme.chip-c;
                Text {
                    text: data.bucket;
                    color: white;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: data.brand + " — " + data.device;
                        color: Theme.foreground;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: data.device-type;
                        color: Theme.muted;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if data.untested: Text {
                        text: "untested upstream";
                        color: Theme.warn;
                        font-size: 11px;
                    }
                    Text {
                        text: data.link-state;
                        font-size: 11px;
                        font-weight: 700;
                        color: data.link-state == "EN" ? Theme.state-en
                            : data.link-state == "DEAD" ? Theme.state-dead
                            : data.link-state == "NON-EN" ? Theme.warn
                            : Theme.faint;
                    }
                }
                if data.has-url: TouchArea {
                    height: 18px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-url(data.url);
                    }
                    Text {
                        x: 0px;
                        width: parent.width;
                        text: data.url;
                        color: Theme.link;
                        font-size: 12px;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }
                if !data.has-url: Text {
                    text: "no link listed in IoST";
                    color: Theme.faint;
                    font-size: 12px;
                }
            }
        }
    }
}

/// A labelled horizontal meter, value in per-mille (may be negative
/// for pleasure: the bar then shows in the warning colour, empty).
component Meter inherits VerticalLayout {
    in property <string> label;
    in property <int> value;
    in property <color> bar-color: Theme.accent;
    spacing: 2px;
    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.muted;
            font-size: 11px;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value + "%";
            color: Theme.foreground;
            font-size: 11px;
            font-weight: 700;
        }
    }
    Rectangle {
        height: 8px;
        background: Theme.surface;
        border-radius: 4px;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.value, 0, 100) / 100;
            height: 8px;
            background: root.bar-color;
            border-radius: 4px;
        }
    }
}

/// One toy on the trial rig: a floating card with telemetry meters
/// and per-channel sliders, stacked for the stage's right edge.
/// Children are positioned absolutely — layout negotiation inside a
/// repeated card proved unreliable in this Slint build. Card height
/// is computed in Rust (sync_trial_model): 120 + 30 per channel.
component TrialToyCard inherits Rectangle {
    in property <TrialToyRow> data;
    callback trial-remove(int);
    callback channel-released(int, int, float);

    height: data.card-height * 1px;
    background: #2a2140f5;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    Text {
        x: 10px;
        y: 7px;
        width: parent.width - 102px;
        text: data.name;
        color: Theme.foreground;
        font-weight: 700;
        overflow: elide;
    }
    Button {
        x: parent.width - 84px;
        y: 4px;
        width: 76px;
        text: "Remove";
        clicked => { root.trial-remove(data.toy-index); }
    }
    Text {
        x: 10px;
        y: 36px;
        text: "Pleasure — how it feels to her";
        color: Theme.muted;
        font-size: 11px;
    }
    Text {
        x: parent.width - 52px;
        y: 36px;
        width: 42px;
        text: data.pleasure + "%";
        color: Theme.foreground;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: right;
    }
    Rectangle {
        x: 10px;
        y: 52px;
        width: parent.width - 20px;
        height: 8px;
        background: Theme.border;
        border-radius: 4px;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * data.pleasure / 100;
            height: 8px;
            background: Theme.pink;
            border-radius: 4px;
        }
    }
    Text {
        x: 10px;
        y: 68px;
        text: "Pressure — how firm it feels";
        color: Theme.muted;
        font-size: 11px;
    }
    Text {
        x: parent.width - 52px;
        y: 68px;
        width: 42px;
        text: data.force + "%";
        color: Theme.foreground;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: right;
    }
    Rectangle {
        x: 10px;
        y: 84px;
        width: parent.width - 20px;
        height: 8px;
        background: Theme.border;
        border-radius: 4px;
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * data.force / 100;
            height: 8px;
            background: Theme.accent;
            border-radius: 4px;
        }
    }
    for channel[ci] in data.channels: Rectangle {
        x: 0px;
        y: (104 + ci * 30) * 1px;
        width: parent.width;
        height: 28px;
        Text {
            x: 10px;
            y: 5px;
            width: 104px;
            text: channel.label;
            color: Theme.muted;
            font-size: 11px;
            overflow: elide;
        }
        Slider {
            x: 120px;
            y: 2px;
            width: parent.width - 182px;
            minimum: 0;
            maximum: channel.max;
            value: channel.level;
            released(value) => {
                root.channel-released(data.toy-index, ci, value);
            }
        }
        Text {
            x: parent.width - 56px;
            y: 5px;
            width: 46px;
            text: channel.level + " / " + channel.max;
            color: Theme.foreground;
            font-size: 11px;
            horizontal-alignment: right;
        }
    }
}

export component MainWindow inherits Window {
    title: "ache — device research lab";
    width: 1280px;
    height: 820px;
    background: @linear-gradient(180deg, #2a2140, #1e1930 45%);

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    in property <[DeviceRow]> devices;
    in property <string> summary;
    callback search-changed(string);
    callback open-url(string);
    callback show-about();
    callback device-selected(int);

    // --- device detail / guide (shared by the shelf and her card) ---
    in property <bool> has-detail: false;
    in property <string> detail-family: "other";
    in property <string> detail-title: "";
    in property <string> detail-what: "";
    in property <string> detail-features: "";
    in property <string> detail-kinks: "";
    in property <string> detail-basis: "";
    in property <int> spin-frame: 0;
    callback add-selected-to-trial();

    // --- Lana state (all values owned by the Rust trial engine) ---
    in property <int> lana-strip-idx: 0;
    in property <int> lana-frame: 0;
    in property <length> lana-x: 0px;
    in property <length> lana-y: 0px;
    in property <string> lana-band: "Composed";
    in property <string> lana-stage: "S0 Composed";
    in property <int> lana-arousal: 0;
    in property <string> lana-reaction: "";
    in property <string> lana-events: "";
    in property <string> lana-params: "";
    in property <string> lana-clip: "";
    in property <image> lana-live-image;
    in property <bool> lana-live-on: false;
    // --- Lana, picked up (drag state owned by drag.rs) ---
    in property <length> lana-drag-x: 0px;
    in property <length> lana-drag-y: 0px;
    in property <angle> lana-angle: 0deg;
    in property <length> lana-origin-x: 120px;
    in property <length> lana-origin-y: 240px;
    in property <bool> lana-held: false;
    out property <length> lana-mouse-x: lana-touch.mouse-x;
    out property <length> lana-mouse-y: lana-touch.mouse-y;
    out property <bool> lana-pressed: lana-touch.pressed;
    callback lana-grab(length, length);
    callback lana-release();
    in property <string> profile-name: "Lana (her own)";
    in property <[float]> zone-values: [100.0, 100.0, 100.0, 100.0];
    in property <string> profile-text: "";
    in property <string> combo-text: "";
    in property <string> trial-note: "";
    in property <string> trial-count: "0 / 10 toys";
    in property <int> zone-ext: 0;
    in property <int> zone-int: 0;
    in property <int> zone-anal: 0;
    in property <int> zone-nip: 0;
    in property <int> total-pleasure: 0;
    in property <image> trace-image;
    in property <[TrialToyRow]> trial-toys;
    in property <int> rig-height: 0;
    in-out property <int> rig-scroll: 0;
    in-out property <bool> show-details: false;
    callback profile-selected(int);
    callback zone-changed(int, float);
    callback trial-remove(int);
    callback channel-released(int, int, float);
    callback trial-clear();

    // --- lexicon ---
    in property <[LexiconRow]> lexicon-rows;
    in property <string> lexicon-title: "";
    in property <string> lexicon-meta: "";
    in property <string> lexicon-body: "";
    in property <bool> lexicon-can-try: false;
    callback lexicon-search(string);
    callback lexicon-select(int);
    callback lexicon-try();

    // --- the room's overlays (hers; nothing here is a document) ---
    in-out property <bool> shelf-open: false;
    in-out property <bool> lexicon-open: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> control-open: false;
    in-out property <bool> detail-closed: false;

    // ================= the stage =================
    Rectangle {
        width: 100%;
        height: 100%;

        // Room light: two soft glows on the gradient, so the stage
        // reads as a place, not a page.
        Rectangle {
            x: 260px;
            y: 20px;
            width: 760px;
            height: 760px;
            border-radius: 380px;
            background: @radial-gradient(circle, #8b5cf614, #8b5cf600);
        }
        Rectangle {
            x: 880px;
            y: 420px;
            width: 460px;
            height: 460px;
            border-radius: 230px;
            background: @radial-gradient(circle, #ec489912, #ec489900);
        }

        // Her contact shadow — an ellipse on her spot, never a
        // panel; it follows her across and thins while she's lifted.
        Rectangle {
            x: 550px + root.lana-x + root.lana-drag-x;
            y: 646px;
            width: 180px;
            height: 20px;
            border-radius: 10px;
            background: @radial-gradient(circle, #00000059, #00000000);
            opacity: root.lana-held ? 0.45 : 1.0;
        }

        // The figure cluster: halo, figure, zone glows. Only the
        // visual child rotates about the grab point; the container
        // — and the TouchArea on it — stays untransformed, so
        // pointer coords are plain figure-local and the grab-point
        // pin is exact at any hang angle (the drag lane's layout
        // trap, carried over whole). Transform owned by drag.rs;
        // geometry mirrors its constants (figure 240x480, rest at
        // 520,170 on the stage).
        lana-fig := Rectangle {
            x: 520px + root.lana-x + root.lana-drag-x;
            y: 170px + root.lana-y + root.lana-drag-y;
            width: 240px;
            height: 480px;
            lana-visual := Rectangle {
                width: 240px;
                height: 480px;
                transform-rotation: root.lana-angle;
                transform-origin: { x: root.lana-origin-x, y: root.lana-origin-y };
                // Her glow — the room answers her arousal.
                Rectangle {
                    x: -40px;
                    y: 27px;
                    width: 320px;
                    height: 427px;
                    border-radius: 160px;
                    background: @radial-gradient(circle, #ec489955, #ec489900);
                    opacity: 0.25 + root.lana-arousal * 0.0075;
                }
                Image {
                    visible: !root.lana-live-on;
                    source: root.lana-strip-idx == 0 ? Assets.lana-idle
                        : root.lana-strip-idx == 1 ? Assets.lana-guiding
                        : root.lana-strip-idx == 2 ? Assets.lana-waiting
                        : root.lana-strip-idx == 3 ? Assets.lana-success
                        : Assets.lana-error;
                    source-clip-x: root.lana-frame * 144;
                    source-clip-y: 0;
                    source-clip-width: 144;
                    source-clip-height: 288;
                    width: 240px;
                    height: 480px;
                }
                // Her live figure: the rig, rendered per-frame by
                // the out-of-process renderer (scope Option C).
                // Same box as the strip; the zone glows below draw
                // over whichever figure is up.
                Image {
                    source: root.lana-live-image;
                    width: 240px;
                    height: 480px;
                    visible: root.lana-live-on;
                }
                // The zones being played, glowing on her body.
                Rectangle {
                    x: 56px;
                    y: 131px;
                    width: 128px;
                    height: 59px;
                    border-radius: 29px;
                    background: @radial-gradient(circle, #f9a8d4cc, #ec489900);
                    opacity: root.zone-nip * 0.008;
                }
                Rectangle {
                    x: 83px;
                    y: 207px;
                    width: 75px;
                    height: 40px;
                    border-radius: 20px;
                    background: @radial-gradient(circle, #f9a8d4cc, #ec489900);
                    opacity: root.zone-ext * 0.008;
                }
                Rectangle {
                    x: 93px;
                    y: 232px;
                    width: 69px;
                    height: 37px;
                    border-radius: 18px;
                    background: @radial-gradient(circle, #f472b6aa, #ec489900);
                    opacity: root.zone-int * 0.008;
                }
                Rectangle {
                    x: 125px;
                    y: 221px;
                    width: 59px;
                    height: 37px;
                    border-radius: 18px;
                    background: @radial-gradient(circle, #f472b6aa, #ec489900);
                    opacity: root.zone-anal * 0.008;
                }
            }
            lana-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: root.lana-held ? MouseCursor.grabbing : MouseCursor.grab;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.lana-grab(self.mouse-x, self.mouse-y);
                    }
                    if (ev.kind == PointerEventKind.up) {
                        root.lana-release();
                    }
                }
            }
        }

        Text {
            x: 20px;
            y: 788px;
            width: 340px;
            text: "Lana — your guide and play partner. Full-body figure, estate-generated (candidate-class). Grab her and pick her up — where you hold her changes how she hangs.";
            color: Theme.faint;
            font-size: 10px;
            wrap: word-wrap;
        }

        // ---- her voice: the conversational panel ----
        FloatCard {
            x: 20px;
            y: 92px;
            width: 320px;
            height: 360px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.lana-band + (root.lana-stage == root.lana-band ? "" : " · " + root.lana-stage);
                    color: Theme.pink-bright;
                    font-weight: 700;
                    font-size: 15px;
                    wrap: word-wrap;
                }
                Meter {
                    label: "Her arousal";
                    value: root.lana-arousal;
                    bar-color: Theme.pink;
                }
                Text {
                    text: "“" + root.lana-reaction + "”";
                    color: Theme.foreground;
                    wrap: word-wrap;
                }
                if root.trial-note != "": Text {
                    text: "Lana: “" + root.trial-note + "”";
                    color: Theme.pink-bright;
                    wrap: word-wrap;
                }
                Text {
                    text: root.lana-events;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.combo-text != "": Text {
                    text: root.combo-text;
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                if !root.has-detail && root.trial-toys.length == 0: Text {
                    text: "Start here: open the toy shelf, pick a toy, add it to her rig, then raise its level gently and watch her.";
                    color: Theme.foreground;
                    wrap: word-wrap;
                }
            }
        }

        // The details toggle: a standing chip under her voice card.
        Rectangle {
            x: 32px;
            y: 464px;
            width: 220px;
            height: 18px;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.show-details = !root.show-details;
                }
            }
            Text {
                text: (root.show-details ? "▾ " : "▸ ") + "Reading her closely — the details";
                color: Theme.faint;
                font-size: 11px;
            }
        }

        // ---- the rig: floating toy cards on the stage's right ----
        Text {
            x: 936px;
            y: 92px;
            width: 200px;
            text: "Play rig — virtual toys";
            color: Theme.accent-bright;
            font-weight: 700;
            font-size: 14px;
        }
        if root.trial-toys.length > 0: Button {
            x: 1092px;
            y: 88px;
            width: 28px;
            text: "▲";
            clicked => {
                root.rig-scroll = max(0, root.rig-scroll - 134);
            }
        }
        if root.trial-toys.length > 0: Button {
            x: 1124px;
            y: 88px;
            width: 28px;
            text: "▼";
            clicked => {
                root.rig-scroll = clamp(root.rig-scroll + 134, 0, max(0, root.rig-height - 618));
            }
        }
        Text {
            x: 1156px;
            y: 94px;
            width: 104px;
            text: root.trial-count;
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: right;
        }
        if root.trial-toys.length == 0: Text {
            x: 936px;
            y: 122px;
            width: 324px;
            text: "Her rig is empty. Open the toy shelf and add something she'd like.";
            color: Theme.faint;
            font-size: 12px;
            wrap: word-wrap;
        }
        // NOTE: a `for` inside a ScrollView clips to the first row
        // in this Slint build (verified by pixel measurement), so the
        // rig stack scrolls manually: unclipped viewport + offset
        // content + step buttons, as in the tabbed build.
        Rectangle {
            x: 936px;
            y: 120px;
            width: 324px;
            height: 618px;
            rig-view := Rectangle {
                width: parent.width;
                height: parent.height;
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    scroll-event(event) => {
                        root.rig-scroll = clamp(root.rig-scroll - event.delta-y / 1px, 0, max(0, root.rig-height - rig-view.height / 1px));
                        return EventResult.accept;
                    }
                }
                Rectangle {
                    y: -root.rig-scroll * 1px;
                    height: root.rig-height * 1px;
                    for toy in root.trial-toys: TrialToyCard {
                        y: toy.y-offset * 1px;
                        width: parent.width;
                        data: toy;
                        trial-remove(index) => { root.trial-remove(index); }
                        channel-released(toy-index, channel, value) => {
                            root.channel-released(toy-index, channel, value);
                        }
                    }
                }
            }
        }

        // ---- watch her: the zone meters, low on the stage ----
        FloatCard {
            x: 380px;
            y: 700px;
            width: 640px;
            height: 100px;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: "Watch her — the glow on her body shows where each toy is playing. These bars are just the details.";
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Meter {
                        label: "Outside";
                        value: root.zone-ext;
                        width: 118px;
                    }
                    Meter {
                        label: "Inside";
                        value: root.zone-int;
                        width: 118px;
                    }
                    Meter {
                        label: "Anal";
                        value: root.zone-anal;
                        width: 118px;
                    }
                    Meter {
                        label: "Nipples";
                        value: root.zone-nip;
                        width: 118px;
                    }
                    Meter {
                        label: "All of her";
                        value: root.total-pleasure;
                        bar-color: Theme.pink;
                        width: 118px;
                    }
                }
            }
        }

        // ---- STOP: always on the stage, one action ----
        Rectangle {
            x: 1110px;
            y: 752px;
            width: 150px;
            height: 48px;
            border-radius: 24px;
            background: Theme.chip-b;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.trial-clear();
                }
            }
            Text {
                text: "■ STOP — all off";
                color: white;
                font-weight: 700;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // ---- wordmark + the MASTER OFF pill (never covered) ----
        Text {
            x: 20px;
            y: 14px;
            text: "ache · device research lab";
            color: Theme.accent-bright;
            font-size: 20px;
            font-weight: 700;
        }
        Rectangle {
            x: 20px;
            y: 48px;
            width: 884px;
            height: 26px;
            border-radius: 13px;
            background: Theme.accent-deep;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                Text {
                    text: "MASTER OFF — device control is not connected in this build, so nothing here can move a real device. Lana's session is a simulation — virtual toys only.";
                    color: white;
                    font-weight: 700;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // ---- navigation chips ----
        HorizontalLayout {
            x: 690px;
            y: 14px;
            spacing: 8px;
            NavChip {
                text: "Toy shelf";
                active: root.shelf-open;
                clicked => {
                    root.shelf-open = !root.shelf-open;
                    root.lexicon-open = false;
                }
            }
            NavChip {
                text: "Guidebook";
                active: root.lexicon-open;
                clicked => {
                    root.lexicon-open = !root.lexicon-open;
                    root.shelf-open = false;
                }
            }
            NavChip {
                text: "How she likes it";
                active: root.settings-open;
                clicked => {
                    root.settings-open = !root.settings-open;
                }
            }
            NavChip {
                text: "Control preview";
                active: root.control-open;
                clicked => {
                    root.control-open = !root.control-open;
                }
            }
            NavChip {
                text: "About";
                clicked => {
                    root.show-about();
                }
            }
        }

        // ---- how she likes it: her preferences, as a card ----
        if root.settings-open: FloatCard {
            x: 20px;
            y: 404px;
            width: 344px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                alignment: start;
                HorizontalLayout {
                    Text {
                        text: "How she likes it — sensitivity & zones";
                        color: Theme.accent-bright;
                        font-weight: 700;
                        font-size: 14px;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    NavChip {
                        text: "✕";
                        clicked => {
                            root.settings-open = false;
                        }
                    }
                }
                Text {
                    text: "Her comfort, her pace — every body is different. These are her preferences; the sliders fine-tune them, zone by zone.";
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 4px;
                    Button {
                        text: "Keen";
                        clicked => { root.profile-selected(0); }
                    }
                    Button {
                        text: "Responsive";
                        clicked => { root.profile-selected(1); }
                    }
                    Button {
                        text: "Lana's own";
                        clicked => { root.profile-selected(2); }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Button {
                        text: "Slow burn";
                        clicked => { root.profile-selected(3); }
                    }
                    Button {
                        text: "Gentle";
                        clicked => { root.profile-selected(4); }
                    }
                }
                Text {
                    text: "Her settings: " + root.profile-name;
                    color: Theme.foreground;
                    font-size: 12px;
                    font-weight: 700;
                }
                for zone[idx] in ["External (clitoral)", "Internal (vaginal)", "Anal", "Nipples"]: HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: zone;
                        color: Theme.muted;
                        font-size: 11px;
                        width: 108px;
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: 20;
                        maximum: 200;
                        value: root.zone-values[idx];
                        horizontal-stretch: 1;
                        released(value) => {
                            root.zone-changed(idx, value);
                        }
                    }
                }
                ScrollView {
                    height: 84px;
                    VerticalLayout {
                        alignment: start;
                        Text {
                            text: root.profile-text;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ---- reading her closely: the details, as an overlay ----
        if root.show-details: FloatCard {
            x: 288px;
            y: 552px;
            width: 648px;
            height: 252px;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                alignment: start;
                HorizontalLayout {
                    Text {
                        text: "Reading her closely — the details";
                        color: Theme.accent-bright;
                        font-weight: 700;
                        font-size: 13px;
                        horizontal-stretch: 1;
                    }
                    NavChip {
                        text: "✕";
                        clicked => {
                            root.show-details = false;
                        }
                    }
                }
                Text {
                    text: root.lana-params;
                    color: Theme.faint;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.lana-clip;
                    color: Theme.faint;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Image {
                    source: root.trace-image;
                    width: 600px;
                    height: 96px;
                    image-fit: fill;
                }
                Text {
                    text: "The last 30 seconds, drawn live — a pink line per toy for how it feels to her, violet for pressure, white for her arousal.";
                    color: Theme.faint;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }

        // ---- the detail card: floats beside her ----
        if root.has-detail && !root.detail-closed: FloatCard {
            x: 916px;
            y: 92px;
            width: 344px;
            height: 560px;
            background: #2a2140;
            NavChip {
                x: parent.width - 44px;
                y: 8px;
                text: "✕";
                clicked => {
                    root.detail-closed = true;
                }
            }
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.detail-title;
                    color: Theme.foreground;
                    font-size: 15px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: "Lana explains";
                    color: Theme.accent-bright;
                    font-weight: 700;
                    font-size: 13px;
                }
                HorizontalLayout {
                    alignment: center;
                    FamilySpin {
                        width: 192px;
                        height: 192px;
                        family: root.detail-family;
                        frame: root.spin-frame;
                    }
                }
                Text {
                    text: "True turntable — 12-frame estate render of the form factor (generic family mesh, not the product).";
                    color: Theme.faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                ScrollView {
                    height: 148px;
                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: root.detail-what;
                            color: Theme.foreground;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.detail-features;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.detail-kinks;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                }
                Text {
                    text: root.detail-basis;
                    color: Theme.faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "Add to Lana's rig";
                        clicked => {
                            root.add-selected-to-trial();
                        }
                    }
                    Button {
                        text: "Ask Lana";
                        clicked => {
                            root.shelf-open = false;
                            root.lexicon-open = false;
                        }
                    }
                }
            }
        }

        // ---- the toy shelf: a drawer over the stage ----
        Rectangle {
            x: root.shelf-open ? 0px : -452px;
            y: 84px;
            width: 452px;
            height: 736px;
            background: #241c3a;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.border;
            animate x { duration: 200ms; easing: ease-out; }
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "The toy shelf";
                        color: Theme.accent-bright;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    NavChip {
                        text: "✕";
                        clicked => {
                            root.shelf-open = false;
                        }
                    }
                }
                Text {
                    text: root.summary;
                    color: Theme.muted;
                    font-size: 12px;
                }
                LineEdit {
                    placeholder-text: "Search brand, device, or type…";
                    edited(text) => {
                        root.search-changed(text);
                    }
                }
                Text {
                    text: "New here? Pick any toy, then choose Ask Lana — she explains it in plain words and sets up a play session. The letter chips say how well the maker data matched (A is best); EN means an English product page, NON-EN another language, DEAD a link that has gone, UNVERIFIED not yet checked.";
                    color: Theme.faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for device in root.devices: ShelfCard {
                        data: device;
                        open-url(url) => {
                            root.open-url(url);
                        }
                        device-selected(index) => {
                            root.detail-closed = false;
                            root.device-selected(index);
                        }
                    }
                }
            }
        }

        // ---- the guidebook: the lexicon, opened over the room ----
        Rectangle {
            x: root.lexicon-open ? 660px : 1280px;
            y: 84px;
            width: 600px;
            height: 720px;
            background: #241c3a;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.border;
            animate x { duration: 200ms; easing: ease-out; }
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Guidebook — the lexicon";
                        color: Theme.accent-bright;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    NavChip {
                        text: "✕";
                        clicked => {
                            root.lexicon-open = false;
                        }
                    }
                }
                LineEdit {
                    placeholder-text: "Search the lexicon…";
                    edited(text) => {
                        root.lexicon-search(text);
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: 218px;
                        ListView {
                            vertical-stretch: 1;
                            for entry[idx] in root.lexicon-rows: Rectangle {
                                height: 44px;
                                border-radius: 8px;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.lexicon-select(idx);
                                    }
                                }
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 1px;
                                    Text {
                                        text: entry.title;
                                        color: Theme.foreground;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: entry.meta;
                                        color: Theme.faint;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: root.lexicon-title;
                            color: Theme.foreground;
                            font-size: 16px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.lexicon-meta;
                            color: Theme.faint;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        ScrollView {
                            height: 420px;
                            VerticalLayout {
                                alignment: start;
                                Text {
                                    text: root.lexicon-body;
                                    color: Theme.foreground;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if root.lexicon-can-try: Button {
                            text: "Try it with Lana — set up her rig";
                            clicked => {
                                root.lexicon-try();
                                root.lexicon-open = false;
                            }
                        }
                    }
                }
            }
        }

        // ---- control preview: an inert card, kept honest ----
        if root.control-open: FloatCard {
            x: 360px;
            y: 190px;
            width: 560px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                HorizontalLayout {
                    Text {
                        text: "Control preview";
                        color: Theme.accent-bright;
                        font-weight: 700;
                        font-size: 15px;
                        horizontal-stretch: 1;
                    }
                    NavChip {
                        text: "✕";
                        clicked => {
                            root.control-open = false;
                        }
                    }
                }
                Text {
                    text: "Control preview — rendering proof only. No device connection exists in this build, and none can be made from this pane.";
                    color: Theme.foreground;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "Master switch";
                        color: Theme.foreground;
                        vertical-alignment: center;
                    }
                    Switch {
                        checked: false;
                        enabled: false;
                    }
                    Text {
                        text: "OFF";
                        color: Theme.link;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "Intensity";
                        color: Theme.foreground;
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: 0;
                        maximum: 100;
                        value: 0;
                        enabled: false;
                        width: 280px;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button {
                        text: "Start pattern";
                        enabled: false;
                    }
                    Button {
                        text: "STOP";
                        enabled: false;
                    }
                }
                Text {
                    text: "While the master switch is off, every control stays inert — including STOP, which is on screen from the first frame. Device wiring lands in a later phase and reaches devices only through ache's decide() gate and tool surface.";
                    wrap: word-wrap;
                    color: Theme.muted;
                }
            }
        }
    }
}

/// About dialog. Displaying the `AboutSlint` widget here, in a dialog
/// reachable from the window's top level, is condition (a) of the Slint
/// Royalty-free License attribution requirement (see README.md).
export component AboutDialog inherits Window {
    title: "About ache";
    width: 440px;
    height: 430px;
    background: Theme.background;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text {
            text: "ache";
            color: Theme.foreground;
            font-size: 22px;
            font-weight: 700;
        }
        Text {
            text: "Unified haptics MCP — device catalogue browser, Lana guide & trial, and lexicon. In plain terms: a friendly catalogue of toys with Lana as your guide, and a play-along simulation of how they feel to her.";
            color: Theme.muted;
            wrap: word-wrap;
        }
        Text {
            text: "ache's own code is licensed under the Apache License 2.0. This application is built with the Slint toolkit under the Slint Royalty-free Desktop, Mobile, and Web Applications License; the required attribution follows.";
            color: Theme.muted;
            wrap: word-wrap;
        }
        AboutSlint { }
    }
}
