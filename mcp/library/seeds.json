  "automations": [
    {
      "format": "ache.automation/v1", "id": "say-stop",
      "_comment": "ALIGNMENT #1: the consent-stop primitive. Register the input as {\"id\": \"say_stop\", \"stop\": true} and its event IS ache's synchronous stop (it never reaches this automation). This automation is the in-program echo for sessions that also want the program's own record of it.",
      "controls": [{"id": "stop", "kind": "stop_button"}],
      "triggers": [{"id": "said", "on": {"external_event": "say_stop"}}],
      "jobs": [{"id": "halt", "trigger": "said", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
        "actions": ["stop_all", {"notify": "stop word heard: all output stopped"}]}]
    },
    {
      "format": "ache.automation/v1", "id": "hyp-clicker",
      "_comment": "ALIGNMENT #4: click → response window → reward. Targets: main.",
      "controls": [{"id": "stop", "kind": "stop_button"}, {"id": "click", "kind": "button"}],
      "variables": [{"id": "clicks", "type": "number", "init": 0, "min": 0, "max": 1000}],
      "triggers": [{"id": "clicked", "on": {"control_pressed": "click"}}],
      "jobs": [{"id": "reward", "trigger": "clicked", "repeat": "once", "max_runs": 1, "max_span_ms": 2000,
        "actions": [{"add_variable": {"var": "clicks", "expr": "1"}}, {"play_pattern": {"pattern": "hyp-click-reward", "target": "main"}}]}]
    },
    {
      "format": "ache.automation/v1", "id": "hyp-keyword-ladder",
      "_comment": "ALIGNMENT #5: four-rung keyword ladder. Register inputs treat, reward, warning, punishment. Punishment is denial (output withdrawn), never pain. Targets: main.",
      "controls": [{"id": "stop", "kind": "stop_button"}],
      "triggers": [
        {"id": "t", "on": {"external_event": "treat"}},
        {"id": "r", "on": {"external_event": "reward"}},
        {"id": "w", "on": {"external_event": "warning"}},
        {"id": "p", "on": {"external_event": "punishment"}}
      ],
      "jobs": [
        {"id": "treat", "trigger": "t", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
          "actions": [{"play_pattern": {"pattern": "ladder-treat", "target": "main"}}]},
        {"id": "reward", "trigger": "r", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
          "actions": [{"play_pattern": {"pattern": "ladder-reward", "target": "main"}}]},
        {"id": "warning", "trigger": "w", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
          "actions": [{"set_function": {"target": "main", "value": "10"}}, {"notify": "warning rung"}]},
        {"id": "punishment", "trigger": "p", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
          "actions": ["stop_all", {"notify": "punishment rung: denial"}]}
      ]
    },
    {
      "format": "ache.automation/v1", "id": "edge-pressure-shape",
      "_comment": "ALIGNMENT #6 (Civet shape). The pressure sensor is not admitted in v1; a registered `edge_near` event stands in for its threshold crossing. Rises from a floor, drops to zero at the edge, recovers from the floor. Targets: main.",
      "controls": [{"id": "stop", "kind": "stop_button"}],
      "variables": [{"id": "level", "type": "number", "init": 20, "min": 0, "max": 90}],
      "triggers": [{"id": "go", "on": "session_start"}, {"id": "edge", "on": {"external_event": "edge_near"}}],
      "jobs": [
        {"id": "ramp", "trigger": "go", "repeat": {"every": {"ms": 1000}}, "max_runs": 600, "max_span_ms": 600000,
          "actions": [{"add_variable": {"var": "level", "expr": "3"}}, {"set_function": {"target": "main", "value": "level"}}]},
        {"id": "back_off", "trigger": "edge", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
          "actions": [{"set_variable": {"var": "level", "expr": "0"}}, {"set_function": {"target": "main", "value": "0"}}, {"notify": "edge: backed off"}]}
      ]
    },
    {
      "format": "ache.automation/v1", "id": "edge-stillness",
      "_comment": "ALIGNMENT #7: stillness raises intensity, movement resets to zero. A registered `movement` event stands in for the motion sensor. Targets: main.",
      "controls": [{"id": "stop", "kind": "stop_button"}],
      "variables": [{"id": "still", "type": "number", "init": 0, "min": 0, "max": 100}],
      "triggers": [{"id": "go", "on": "session_start"}, {"id": "moved", "on": {"external_event": "movement"}}],
      "jobs": [
        {"id": "reward_stillness", "trigger": "go", "repeat": {"every": {"ms": 1000}}, "max_runs": 600, "max_span_ms": 600000,
          "actions": [{"add_variable": {"var": "still", "expr": "2"}}, {"set_function": {"target": "main", "value": "still"}}]},
        {"id": "reset", "trigger": "moved", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
          "actions": [{"set_variable": {"var": "still", "expr": "0"}}, {"set_function": {"target": "main", "value": "0"}}]}
      ]
    },
    {
      "format": "ache.automation/v1", "id": "hr-trainer",
      "_comment": "ALIGNMENT #8: heart-rate edge trainer + HR-intensity law. Register inputs hr_high and hr_ok (threshold crossings, names only). Targets: main.",
      "controls": [{"id": "stop", "kind": "stop_button"}],
      "variables": [
        {"id": "level", "type": "number", "init": 10, "min": 0, "max": 85},
        {"id": "cooling", "type": "bool", "init": false}
      ],
      "triggers": [
        {"id": "go", "on": "session_start"},
        {"id": "high", "on": {"external_event": "hr_high"}},
        {"id": "ok", "on": {"external_event": "hr_ok"}}
      ],
      "jobs": [
        {"id": "law", "trigger": "go", "repeat": {"every": {"ms": 2000}}, "max_runs": 300, "max_span_ms": 600000,
          "actions": [{"add_variable": {"var": "level", "expr": "select(cooling, 0 - 5, 4)"}}, {"set_function": {"target": "main", "value": "select(cooling, min(level, 15), level)"}}]},
        {"id": "cool", "trigger": "high", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
          "actions": [{"set_variable": {"var": "cooling", "expr": "1"}}, {"set_function": {"target": "main", "value": "15"}}]},
        {"id": "resume", "trigger": "ok", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
          "actions": [{"set_variable": {"var": "cooling", "expr": "0"}}]}
      ]
    },
    {
      "format": "ache.automation/v1", "id": "denial-arousal-meter",
      "_comment": "ALIGNMENT #10: a metered build; at the meter's peak the session denies (all output withdrawn) and the meter falls back. Targets: main.",
      "controls": [{"id": "stop", "kind": "stop_button"}],
      "variables": [{"id": "arousal", "type": "number", "init": 0, "min": 0, "max": 100}],
      "triggers": [
        {"id": "go", "on": "session_start"},
        {"id": "peak", "on": {"variable_crossed": {"var": "arousal", "cmp": "ge", "value": 85}}}
      ],
      "jobs": [
        {"id": "build", "trigger": "go", "repeat": {"every": {"ms": 1000}}, "max_runs": 600, "max_span_ms": 600000,
          "actions": [{"add_variable": {"var": "arousal", "expr": "5"}}, {"set_function": {"target": "main", "value": "arousal * 0.8"}}]},
        {"id": "deny", "trigger": "peak", "repeat": "once", "max_runs": 1, "max_span_ms": 1000,
          "actions": ["stop_all", {"set_variable": {"var": "arousal", "expr": "20"}}, {"notify": "denied at the meter's peak"}]}
      ]
    }
  ]
}
